description "TIFF image file format\3770,128,128";

options(BUILDER_OPTION) NOWARNINGS;

uses
	plugin\jpg,
	Painter;

library
	"tiff lzma jpeg";

options
	-DSTDC,
	-DCHECK_JPEG_YCBCR_SUBSAMPLING,
	-DDEFAULT_EXTRASAMPLE_AS_ALPHA,
	-DSTRIPCHOP_DEFAULT=TIFF_STRIPCHOP,
	-DPIXARLOG_SUPPORT,
	-DZIP_SUPPORT,
	-DOJPEG_SUPPORT,
	-DJPEG_SUPPORT,
	-DLOGLUV_SUPPORT,
	-DNEXT_SUPPORT,
	-DTHUNDER_SUPPORT,
	-DLZW_SUPPORT,
	-DPACKBITS_SUPPORT,
	-DCCITT_SUPPORT;

external_dependency
	tiff;

file
	tif.h,
	tifupp.cpp,
	Copying;

